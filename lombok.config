config.stopBubbling = true

# Lombok configuration file
# This file configures Lombok's behavior for the @CustomLog annotation

# Enable @Generated annotation on Lombok-generated code (useful for code coverage tools)
# lombok.addLombokGeneratedAnnotation = true

# Custom logger declaration for @CustomLog
# Format: lombok.log.custom.declaration=<LoggerType> <LoggerFactoryMethod>
# TYPE will be replaced with the class name at compile time
lombok.log.custom.declaration = com.arkticor.log.CommonLogger com.arkticor.log.CommonLoggerFactory.getLogger(TYPE)

# Optional: Configure the logger field name (default is 'log')
# lombok.log.fieldName = log

# Optional: Configure whether to make the logger field static (default is true)
# lombok.log.staticField = true
